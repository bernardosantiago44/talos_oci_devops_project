<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.6</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.springboot</groupId>
	<artifactId>MyTodoList</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>MyTodoList</name>
	<description>Demo project for Spring Boot</description>
	<properties>
		<java.version>25</java.version>
		<version.lib.ojdbc>21.1.0.0</version.lib.ojdbc>
		<byte-buddy-agent.version>1.17.7</byte-buddy-agent.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!-- https://mvnrepository.com/artifact/org.hibernate.orm/hibernate-community-dialects -->
		<dependency>
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-community-dialects</artifactId>
			<version>6.6.22.Final</version>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.8.0</version>
		</dependency>
		<dependency>
			<groupId>org.apache.httpcomponents.client5</groupId>
			<artifactId>httpclient5</artifactId>			
		</dependency>
		<dependency>
			<groupId>com.oracle.database.jdbc</groupId>
			<artifactId>ojdbc11-production</artifactId>
			<version>23.9.0.25.07</version>
			<exclusions>
				<exclusion>
					<groupId>com.oracle.database.ha</groupId>
					<artifactId>simplefan</artifactId>
				</exclusion>
			</exclusions>
			<type>pom</type>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>			
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>			
		</dependency>
		<dependency>
			<groupId>net.bytebuddy</groupId>
			<artifactId>byte-buddy-agent</artifactId>
			<version>${byte-buddy-agent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.telegram</groupId>
			<artifactId>telegrambots-springboot-longpolling-starter</artifactId>
			<version>9.1.0</version>
		</dependency>
		<dependency>
			<groupId>org.telegram</groupId>
			<artifactId>telegrambots-client</artifactId>
			<version>9.1.0</version>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>1.18.44</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.jetbrains.kotlin</groupId>
			<artifactId>kotlin-reflect</artifactId>
			<version>1.9.22</version> <!-- Use the version compatible with your Spring Boot parent -->
		</dependency>
 </dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<release>25</release>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>1.18.44</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Start of delivery for module 5 -->
			<plugin>
				<groupId>de.elnarion.maven</groupId>
				<artifactId>plantuml-generator-maven-plugin</artifactId>
				<version>3.0.1</version>
				<configuration>
					<outputDirectory>${project.basedir}/../doc/arch/generated/level-4</outputDirectory>
					<scanPackages>
						<scanPackage>com.springboot.MyTodoList</scanPackage>
					</scanPackages>
					<hideFields>true</hideFields>
					<hideMethods>true</hideMethods>
					<useShortClassNames>true</useShortClassNames>
					<useShortClassNamesInFieldsAndMethods>true</useShortClassNamesInFieldsAndMethods>
				</configuration>
				<executions>
					<execution>
						<id>generate-rest-controllers-diagram</id>
						<phase>prepare-package</phase>
						<goals><goal>generate</goal></goals>
						<configuration>
							<outputFilename>rest-controllers.puml</outputFilename>
							<whitelistRegexp>com.springboot.MyTodoList.(controller|service)..*</whitelistRegexp>
						</configuration>
					</execution>
					<execution>
						<id>generate-work-management-diagram</id>
						<phase>prepare-package</phase>
						<goals><goal>generate</goal></goals>
						<configuration>
							<outputFilename>work-management.puml</outputFilename>
							<whitelistRegexp>com.springboot.MyTodoList.(service.(WorkItemService|TagsService|WorkItemTagAssignmentService|WorkItemAssignmentService|SprintService)|repository.(WorkItemRepository|TagsRepository|WorkItemTagAssignmentRepository|WorkItemAssignmentRepository|SprintRepository)|model.(WorkItem|WorkItemPriority|WorkItemTag|WorkItemTagId|Tag|WorkItemAssignment|Sprint|AppUser)|dto.(WorkItem|tag)..*|query.WorkItemQuery)</whitelistRegexp>
						</configuration>
					</execution>
					<execution>
						<id>generate-time-tracking-diagram</id>
						<phase>prepare-package</phase>
						<goals><goal>generate</goal></goals>
						<configuration>
							<outputFilename>time-tracking.puml</outputFilename>
							<whitelistRegexp>com.springboot.MyTodoList.(controller.TimeEntryController|service.TimeEntryService|repository.(TimeEntryRepository|WorkItemRepository|AppUserRepository)|model.(TimeEntry|WorkItem|AppUser)|dto.timeEntry..*)</whitelistRegexp>
						</configuration>
					</execution>
					<execution>
						<id>generate-activity-tracking-diagram</id>
						<phase>prepare-package</phase>
						<goals><goal>generate</goal></goals>
						<configuration>
							<outputFilename>activity-tracking.puml</outputFilename>
							<whitelistRegexp>com.springboot.MyTodoList.service.(WorkItemService|WorkItemAssignmentService|TimeEntryService|SprintService|TagsService|WorkItemTagAssignmentService)</whitelistRegexp>
						</configuration>
					</execution>
					<execution>
						<id>generate-bot-interface-diagram</id>
						<phase>prepare-package</phase>
						<goals><goal>generate</goal></goals>
						<configuration>
							<outputFilename>bot-interface.puml</outputFilename>
							<whitelistRegexp>com.springboot.MyTodoList.(util.(MyTodoListBot|BotClient|BotHelper|BotCommands|BotLabels|BotMessages)|config.BotProps)</whitelistRegexp>
						</configuration>
					</execution>
					<execution>
						<id>generate-sprint-management-diagram</id>
						<phase>prepare-package</phase>
						<goals><goal>generate</goal></goals>
						<configuration>
							<outputFilename>sprint-management.puml</outputFilename>
							<whitelistRegexp>com.springboot.MyTodoList.(controller.SprintController|service.SprintService|repository.SprintRepository|model.Sprint|dto.sprint..*)</whitelistRegexp>
						</configuration>
					</execution>
					<execution>
						<id>generate-assignment-management-diagram</id>
						<phase>prepare-package</phase>
						<goals><goal>generate</goal></goals>
						<configuration>
							<outputFilename>assignment-management.puml</outputFilename>
							<whitelistRegexp>com.springboot.MyTodoList.(controller.WorkItemController|service.(WorkItemAssignmentService|WorkItemService)|repository.(WorkItemAssignmentRepository|WorkItemRepository|AppUserRepository)|model.(WorkItemAssignment|WorkItem|AppUser)|dto.WorkItem..*)</whitelistRegexp>
						</configuration>
					</execution>
					<execution>
						<id>generate-reporting-analytics-diagram</id>
						<phase>prepare-package</phase>
						<goals><goal>generate</goal></goals>
						<configuration>
							<outputFilename>reporting-kpi-analytics.puml</outputFilename>
							<whitelistRegexp>com.springboot.MyTodoList.(controller.AnalyticsController|service.AnalyticsService|repository.AnalyticsRepository|model.(AnalyticsDashboard|AnalyticsDebug|AnalyticsKpis|DeveloperSprintAnalytics|SprintVelocity|SprintVelocityRow|VelocityAnalytics))</whitelistRegexp>
						</configuration>
					</execution>
					<execution>
						<id>generate-semantic-search-diagram</id>
						<phase>prepare-package</phase>
						<goals><goal>generate</goal></goals>
						<configuration>
							<outputFilename>semantic-search-ai-integration.puml</outputFilename>
							<whitelistRegexp>com.springboot.MyTodoList.(controller.SemanticSearchController|service.(SemanticSearchService|EmbeddingService|DeepSeekService)|repository.WorkItemRepository|model.WorkItem|dto.(search|WorkItem)..*|config.(AlibabaEmbeddingConfig|DeepSeekConfig)|exception.AiServiceUnavailableException)</whitelistRegexp>
						</configuration>
					</execution>
					<execution>
						<id>generate-persistence-repositories-diagram</id>
						<phase>prepare-package</phase>
						<goals><goal>generate</goal></goals>
						<configuration>
							<outputFilename>persistence-repositories.puml</outputFilename>
							<whitelistRegexp>com.springboot.MyTodoList.(repository|model)..*</whitelistRegexp>
						</configuration>
					</execution>
					<execution>
						<id>generate-domain-model-diagram</id>
						<phase>prepare-package</phase>
						<goals><goal>generate</goal></goals>
						<configuration>
							<outputFilename>domain-model.puml</outputFilename>
							<whitelistRegexp>com.springboot.MyTodoList.(model|dto)..*</whitelistRegexp>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- End of delivery for module 5 -->
			<plugin>
				<groupId>de.elnarion.maven</groupId>
				<artifactId>plantuml-generator-maven-plugin</artifactId>
				<version>3.0.1</version>
				<configuration>
					<outputDirectory>${project.basedir}/../doc/arch/generated/level-3</outputDirectory>
					<scanPackages>
						<scanPackage>com.springboot.MyTodoList</scanPackage>
					</scanPackages>
					<hideFields>true</hideFields>
